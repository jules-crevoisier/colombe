# Annuaire de test « Université Exemple » (dc=universite,dc=example), pour
# docker-compose.ldap.yml. ~15 personnes, schéma inetOrgPerson uniquement : l'image
# osixia/openldap n'embarque pas les schémas eduPerson/SupAnn par défaut, donc pas de
# eduPersonPrimaryAffiliation ici (LDAP_ATTR_AFFILIATION reste absent → affiliation
# null côté API, ce qui est le comportement attendu et couvert par les tests). ou/title
# restent des attributs inetOrgPerson standard, donc bien présents.
#
# Un établissement réel avec un schéma SupAnn/eduPerson verrait `affiliation` rempli
# normalement (voir docs/admin/configuration.md).

dn: ou=people,dc=universite,dc=example
objectClass: organizationalUnit
ou: people

dn: uid=jdupont,ou=people,dc=universite,dc=example
objectClass: inetOrgPerson
uid: jdupont
cn: Jean Dupont
sn: Dupont
givenName: Jean
displayName: Jean Dupont
mail: jean.dupont@universite.example
telephoneNumber: +33325000001
title: Maître de conférences
ou: Informatique


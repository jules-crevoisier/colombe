# Copier en .env et remplir. NE JAMAIS COMMITER .env
# Voir docs/SERVEUR.md pour le detail des parametres.

# --- Serveur mail ---
MAIL_HOST=mail.mmi-troyes.fr
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_PORT=587
MAIL_SMTP_REQUIRE_TLS=true

# --- Compte de developpement ---
# Creer un compte dedie, ne pas utiliser prof@ (voir docs/SERVEUR.md)
MAIL_USER=dev-webmail@mmi-troyes.fr
MAIL_PASS=

# --- Session ---
# Cle de chiffrement du cookie de session.
# Generer avec : openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# --- Divers ---
NODE_ENV=development

# mock = backend en mémoire (dev/tests), imap = serveur réel
MAIL_BACKEND=imap

# true seulement derriere le reverse proxy Apache (X-Forwarded-For)
NUXT_MAIL_TRUST_PROXY=false

# --- Stockage local (preferences, contacts, 2FA) ---
# Cle de chiffrement des secrets 2FA, DIFFERENTE de NUXT_SESSION_PASSWORD.
# Generer avec : openssl rand -base64 32
WEBMAIL_DATA_KEY=
WEBMAIL_DATA_DIR=.data

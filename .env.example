# Copier en .env et remplir. NE JAMAIS COMMITER .env (voir docs/admin/CONFIGURATION.md).
#
# Toutes les variables ci-dessous sont lues au DÉMARRAGE du processus (server/lib/config),
# jamais figées au moment du build : la même archive de release sert n'importe quel
# établissement — il suffit de changer ce fichier et de redémarrer.
#
# Pour développer sans serveur mail du tout, MAIL_BACKEND=mock suffit : un backend en
# mémoire avec des comptes de démonstration (voir server/lib/mail/mock.ts), aucune des
# variables « Serveur mail » ci-dessous n'est alors nécessaire.

# --- Divers ---
NODE_ENV=development

# --- Backend mail ---
# imap = serveur réel (Dovecot/Postfix ou équivalent). mock = backend en mémoire,
# comptes de démonstration, sans réseau (dev/tests uniquement — interdit en production
# sauf WEBMAIL_ALLOW_MOCK=1).
MAIL_BACKEND=imap

# --- Serveur mail (obligatoire si MAIL_BACKEND=imap) ---
# Hôte commun IMAP + SMTP. Pour des hôtes différents, utiliser MAIL_IMAP_HOST /
# MAIL_SMTP_HOST à la place (MAIL_HOST reste alors un repli pour les deux).
MAIL_HOST=mail.univ-exemple.fr
# MAIL_IMAP_HOST=
# MAIL_SMTP_HOST=
# Nom vérifié dans le certificat TLS (SNI), si différent de l'hôte de connexion
# (ex. connexion en 127.0.0.1 avec le certificat public du serveur).
# MAIL_TLS_SERVERNAME=

MAIL_IMAP_PORT=993
# true : TLS implicite (défaut si le port n'est pas 143). false : STARTTLS.
MAIL_IMAP_SECURE=true

MAIL_SMTP_PORT=587
# true : TLS implicite (465). false : STARTTLS (587, défaut).
MAIL_SMTP_SECURE=false
MAIL_SMTP_REQUIRE_TLS=true

# ATTENTION : ne JAMAIS mettre "false" en production (certificat non vérifié).
# Sert uniquement en dev, contre le certificat auto-signé d'un conteneur de test
# (docker compose up -d dovecot / greenmail) — voir aussi WEBMAIL_ALLOW_INSECURE_TLS.
MAIL_TLS_REJECT_UNAUTHORIZED=true

# --- Connexion des utilisateurs ---
# Domaine(s) des adresses de l'établissement, séparés par des virgules/espaces.
# Obligatoire si MAIL_BACKEND=imap (le backend mock utilise universite.example par défaut).
MAIL_DOMAINS=univ-exemple.fr
# Domaine ajouté automatiquement quand l'utilisateur saisit un identifiant sans « @ ».
# Par défaut : le domaine unique de MAIL_DOMAINS s'il n'y en a qu'un, sinon aucun.
# Mettre "none" pour désactiver explicitement même avec un seul domaine.
# MAIL_LOGIN_DEFAULT_DOMAIN=univ-exemple.fr
# Identifiant présenté au serveur IMAP/SMTP/ManageSieve : l'adresse complète (défaut)
# ou seulement la partie avant « @ » (certains annuaires attendent un uid).
MAIL_LOGIN_USERNAME=email

# --- Filtres, réponse automatique, transfert (ManageSieve, RFC 5804) ---
# false désactive entièrement les filtres côté interface (aucune connexion tentée).
MAIL_SIEVE_ENABLED=true
# Hôte/port ManageSieve. Défaut : le même hôte que MAIL_HOST/MAIL_IMAP_HOST, port 4190.
# MAIL_SIEVE_HOST=
MAIL_SIEVE_PORT=4190
# Nom vérifié dans le certificat TLS de ManageSieve, si différent de MAIL_TLS_SERVERNAME
# (utile quand ManageSieve écoute en 127.0.0.1 avec le certificat public du serveur).
# MAIL_SIEVE_TLS_SERVERNAME=
# Domaines autorisés comme destination d'un transfert/redirection/notification (liste
# séparée par des virgules). Défaut : MAIL_DOMAINS (transfert interne uniquement).
# MAIL_FORWARD_DOMAINS=univ-exemple.fr

# --- Paramètres publics (affichés à l'utilisateur pour configurer un autre logiciel) ---
# Hôtes PUBLICS, qui peuvent différer de ceux utilisés par Colombe elle-même (souvent
# "localhost" quand Colombe tourne sur le serveur de messagerie). Vides par défaut :
# aucun paramètre n'est affiché si l'hôte interne est en boucle locale.
# MAIL_PUBLIC_HOST=mail.univ-exemple.fr
# MAIL_PUBLIC_IMAP_HOST=
# MAIL_PUBLIC_SMTP_HOST=
# MAIL_PUBLIC_IMAP_PORT=
# MAIL_PUBLIC_SMTP_PORT=

# --- Réseau ---
# true seulement derrière un reverse proxy de confiance (X-Forwarded-For) : voir clientIp().
MAIL_TRUST_PROXY=false

# --- Identité visuelle (page de connexion) ---
# Tout est facultatif : à défaut, l'interface reste générique ("Colombe", sans organisation).
# COLOMBE_NAME=Colombe
# COLOMBE_ORG_NAME=Université Exemple
# COLOMBE_LOGIN_MESSAGE=Messagerie de l'Université Exemple
# Logo affiché sur la page de connexion (servi par GET /api/branding/logo). Chemin
# absolu ou relatif à la racine du projet ; .svg, .png, .jpg ou .webp.
# COLOMBE_LOGO_FILE=
# COLOMBE_SUPPORT_EMAIL=support@univ-exemple.fr
# COLOMBE_SUPPORT_URL=https://support.univ-exemple.fr
# COLOMBE_PASSWORD_RESET_URL=https://compte.univ-exemple.fr/mot-de-passe-oublie
# Langue de l'interface (fr ou en) si le navigateur ne propose ni français ni anglais.
# COLOMBE_DEFAULT_LANGUAGE=fr

# --- Session ---
# Clé de chiffrement du cookie de session (obligatoire en production, 32 caractères mini).
# Générer avec : openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# --- Stockage local (préférences, contacts, 2FA) ---
# Clé de chiffrement des secrets 2FA, DIFFÉRENTE de NUXT_SESSION_PASSWORD (obligatoire
# en production, 32 caractères mini). Générer avec : openssl rand -base64 32
WEBMAIL_DATA_KEY=
WEBMAIL_DATA_DIR=.data

# --- Déploiement sous un sous-chemin (ex. https://exemple.fr/colombe/) ---
# Lu au runtime par Nuxt lui-même (pas server/lib/config). Toujours terminer par "/".
# NUXT_APP_BASE_URL=/colombe/

# --- Dérogations explicites (jamais en usage normal) ---
# Autorise MAIL_BACKEND=mock en production (démos, environnement de recette).
# WEBMAIL_ALLOW_MOCK=1
# Autorise MAIL_TLS_REJECT_UNAUTHORIZED=false en production (ne jamais faire sur un
# établissement réel : certificat TLS non vérifié).
# WEBMAIL_ALLOW_INSECURE_TLS=1

# --- Limites (fenêtre de 15 minutes) — voir docs/admin/CONFIGURATION.md ---
# Envois par compte (à aligner sur la politique de Postfix).
# COLOMBE_SEND_LIMIT=20
# Échecs de connexion par adresse, puis par IP (large : établissements derrière une IP NAT).
# COLOMBE_LOGIN_LIMIT_ACCOUNT=5
# COLOMBE_LOGIN_LIMIT_IP=30
# Total des pièces jointes d'un message, en Mo (penser à client_max_body_size côté Nginx).
# COLOMBE_MAX_ATTACHMENTS_MB=10

# ─── Annuaire LDAP de l'établissement (recherche seule, jamais d'authentification) ───
# Défini = fonctionnalité activée (GET /api/directory/search, « Annuaire » dans
# Contacts, suggestions dans le champ destinataires). Absent = fonctionnalité éteinte,
# comportement inchangé. Voir docs/admin/configuration.md.
# LDAP_URL=ldaps://annuaire.univ-exemple.fr:636
# StartTLS (RFC 4513) sur une URL ldap://. Obligatoire pour ldap:// vers un hôte
# distant (interdit sinon : le mot de passe de liaison circulerait en clair) — ldap://
# vers 127.0.0.1/localhost reste accepté sans STARTTLS pour le développement.
# LDAP_STARTTLS=false
# DN et mot de passe de liaison. Les deux ensemble, ou aucun (liaison anonyme).
# LDAP_BIND_DN=cn=lecteur-colombe,dc=univ-exemple,dc=fr
# LDAP_BIND_PASSWORD=
# Base de recherche (obligatoire si LDAP_URL est défini).
# LDAP_BASE_DN=dc=univ-exemple,dc=fr
# Filtre combiné en ET avec les termes de recherche.
# LDAP_FILTER=(&(objectClass=inetOrgPerson)(mail=*))
# Attributs comparés à chaque mot de la requête.
# LDAP_SEARCH_ATTRS=cn,displayName,mail,sn,givenName,uid
# Attributs LDAP → champs de la fiche annuaire. Défauts adaptés à SupAnn (sur
# inetOrgPerson + eduPerson) ; LDAP_ATTR_NAME se replie sur cn si absent.
# LDAP_ATTR_NAME=displayName
# LDAP_ATTR_EMAIL=mail
# LDAP_ATTR_PHONE=telephoneNumber
# LDAP_ATTR_TITLE=title
# Sites SupAnn : préférer supannEntiteAffectation (code brut affiché tel quel).
# LDAP_ATTR_DEPARTMENT=ou
# LDAP_ATTR_AFFILIATION=eduPersonPrimaryAffiliation
# Résultats maximum (1-100), longueur minimale de requête, délai LDAP (ms).
# LDAP_MAX_RESULTS=20
# LDAP_MIN_QUERY=3
# LDAP_TIMEOUT_MS=5000
# Valeurs d'affiliation exclues des résultats, séparées par des virgules.
# LDAP_HIDE_AFFILIATIONS=
# --- Connexion unique OpenID Connect (CAS, Shibboleth, Keycloak, Entra…) ---
# Méthodes proposées sur la page de connexion : password, oidc (au moins une).
# AUTH_METHODS=password
# Émetteur (découverte <émetteur>/.well-known/openid-configuration), https obligatoire.
# OIDC_ISSUER=https://idp.univ-exemple.fr/realms/univ
# OIDC_CLIENT_ID=colombe
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid email profile offline_access
# Revendication portant l'adresse ; sans @, MAIL_LOGIN_DEFAULT_DOMAIN est ajouté.
# OIDC_EMAIL_CLAIM=email
# OIDC_BUTTON_LABEL=Se connecter avec mon compte de l'établissement
# Déconnexion aussi chez le fournisseur (end_session_endpoint).
# OIDC_LOGOUT=true
# URL de retour imposée (sinon <origine><base>api/auth/oidc/callback).
# OIDC_REDIRECT_URL=https://webmail.univ-exemple.fr/api/auth/oidc/callback
# Accès IMAP/SMTP/ManageSieve des sessions OIDC : oauth2 (jeton, recommandé) ou master.
# MAIL_SSO_AUTH=oauth2
# MAIL_OAUTH_MECHANISM=xoauth2
# Mode master uniquement (utilisateur maître Dovecot : ouvre TOUTES les boîtes).
# MAIL_MASTER_USER=colombe
# MAIL_MASTER_PASSWORD=
# MAIL_MASTER_SEPARATOR=*
# Lien « Retour à l'ENT » (menu et après déconnexion).
# COLOMBE_PORTAL_URL=https://ent.univ-exemple.fr/

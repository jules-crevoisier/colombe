{
  "name": "colombe",
  "version": "1.0.0-rc.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:mock": "cross-env MAIL_BACKEND=mock nuxt dev",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --project integration",
    "test:api": "node scripts/with-build-lock.mjs \"nuxt build && vitest run --project api\"",
    "test:dovecot": "node scripts/with-build-lock.mjs \"nuxt build && vitest run --project integration-dovecot\"",
    "release": "node scripts/build-release.mjs",
    "setup": "node scripts/colombe-setup.mjs",
    "doctor": "node scripts/colombe-doctor.mjs",
    "import:roundcube": "node scripts/import-roundcube.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:screenshots": "node docs/.vitepress/scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@lucide/vue": "^1.47.0",
    "@pinia/nuxt": "^1.0.2",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "imapflow": "^2.0.5",
    "isomorphic-dompurify": "^4.2.0",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mailparser": "^3.4.6",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.14.5",
    "shadcn-nuxt": "^2.8.2",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "vue-demi"
    ]
  },
  "packageManager": "pnpm@10.11.0",
  "license": "AGPL-3.0-or-later"
}

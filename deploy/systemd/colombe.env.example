# Copier en /etc/colombe/colombe.env (droits 600, propriétaire colombe) et remplir.
# Référence complète : ../../.env.example et docs/admin/configuration.md.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100
WEBMAIL_DATA_DIR=/var/lib/colombe

# --- Chemin public (sous-chemin Apache/Nginx, ex. /colombe/) ---
NUXT_APP_BASE_URL=/colombe/

# --- Serveur mail de l'établissement ---
MAIL_BACKEND=imap
MAIL_HOST=localhost
MAIL_DOMAINS=example.org
# Derrière le reverse proxy Apache/Nginx (X-Forwarded-For) :
MAIL_TRUST_PROXY=true

# --- Secrets (générer avec : openssl rand -base64 32, à sauvegarder à part) ---
NUXT_SESSION_PASSWORD=
WEBMAIL_DATA_KEY=
